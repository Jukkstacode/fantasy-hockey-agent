# Yahoo app credentials: https://developer.yahoo.com/apps/ (Fantasy Sports, Read/Write)
YAHOO_CONSUMER_KEY=your-consumer-key
YAHOO_CONSUMER_SECRET=your-consumer-secret
YAHOO_LEAGUE_ID=12345
YAHOO_TEAM_ID=1
YAHOO_GAME_CODE=nhl
# Set to true if a browser is available for --auth; otherwise a URL is printed
YAHOO_BROWSER_CALLBACK=false

LOG_LEVEL=INFO

# Waiver thresholds
WAIVER_MIN_IMPROVEMENT_PCT=15
WAIVER_MIN_GAMES=3
WAIVER_MAX_ADDS_PER_WEEK=4
MATCHUP_GAA_THRESHOLD=3.0

# Scout thresholds (defaults shown; see SCOUTING_PLAN.md)
SCOUT_RECENT_GAMES=3
SCOUT_BASELINE_GAMES=10
SCOUT_PP_SHARE_JUMP=0.15
SCOUT_PP_TOP_N=5
SCOUT_ES_JUMP_MIN=2.0
SCOUT_REGRESSION_MIN_GP=15
SCOUT_REGRESSION_XG_DIFF=3.0
SCOUT_OWNERSHIP_JUMP=10
SCOUT_REPEAT_DAYS=3
SCOUT_MAX_ACT_NOW=5
SCOUT_MAX_RISING=8
SCOUT_MAX_WATCHLIST=8
SCOUT_AVAILABLE_POOL=300

# News scout (optional). Leave the key blank to skip news classification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# NEWS_FEEDS=comma,separated,rss,urls   (defaults: Rotowire, DailyFaceoff, r/fantasyhockey)

# Email (Gmail app password)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=where.to.send@example.com
